# Copie para .env e preencha. NUNCA versione o .env.

# "desenvolvimento" libera CORS para localhost; use "producao" no Render
AMBIENTE=desenvolvimento

# Origens extras liberadas no CORS, separadas por vírgula (*.vercel.app já é aceito)
CORS_ORIGINS=

# Se preenchida, POST /api/sensores e /api/sensores/lote exigem o header X-Device-Key
DEVICE_KEY=

# IBM Watson Assistant v2 (F5)
WATSON_API_KEY=
WATSON_SERVICE_URL=
WATSON_ASSISTANT_ID=
# ID do ambiente (draft ou live): Environments → ambiente → API details.
# Na experiência "classic" (Dialog skill da F5), use o próprio WATSON_ASSISTANT_ID.
WATSON_ENVIRONMENT_ID=
WATSON_VERSION=2021-06-14
